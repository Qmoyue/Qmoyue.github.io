{
  "name": "moyue-blog",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": "^22.18.0 || ^24.11.0"
  },
  "packageManager": "pnpm@11.28.4",
  "scripts": {
    "dev:bg": "astro dev --background",
    "dev:status": "astro dev status",
    "dev:logs": "astro dev logs",
    "dev:stop": "astro dev stop",
    "content:report": "node scripts/report-content-contract.ts",
    "content:check": "node scripts/report-content-contract.ts --strict",
    "build": "pnpm run content:check && astro build",
    "check": "astro check",
    "lint": "oxlint src scripts tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "capture:visual": "playwright test --config playwright.visual.config.ts",
    "validate": "pnpm run format:check && pnpm run lint && pnpm run check && pnpm run test:unit",
    "verify": "pnpm audit --audit-level low && pnpm run validate && pnpm run test:e2e",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.3.8",
    "@astrojs/vue": "7.0.3",
    "astro": "7.2.8",
    "astro-expressive-code": "0.44.2",
    "matter-js": "0.20.0",
    "reka-ui": "2.10.5",
    "satteri": "0.10.5",
    "sharp": "0.35.5",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.61.1",
    "@types/matter-js": "0.20.2",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.2",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "oxlint": "1.83.0",
    "prettier": "3.9.4",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "4.1.11",
    "yaml": "2.9.0"
  }
}
