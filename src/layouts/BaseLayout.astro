---
import DropdownNav from "../components/navigation/DropdownNav.astro";
import SakuraField from "../components/effects/SakuraField.astro";
import SiteFooter from "../components/shared/SiteFooter.astro";
import ReadingProgress from "../islands/ReadingProgress.vue";
import type { PageMetadata } from "../framework/contracts/metadata";
import PageHead from "../components/shared/PageHead.astro";
import "../site/styles.css";
import { blogConfig, site, navItems } from "../site/config";

interface Props {
  metadata: PageMetadata;
  bodyClass?: string;
  showSakura?: boolean;
  showReadingProgress?: boolean;
}

const {
  metadata,
  bodyClass = "",
  showSakura = true,
  showReadingProgress = true,
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN" data-theme={blogConfig.preset.id}>
  <PageHead metadata={metadata} />
  <body class={bodyClass}>
    <slot name="effects">
      {showSakura && <SakuraField count={blogConfig.preset.sakura.count} />}
    </slot>
    <slot name="navigation"><DropdownNav items={navItems} /></slot>
    <slot name="progress">
      {
        showReadingProgress && (
          <ReadingProgress thumbSrc={site.doro} client:idle />
        )
      }
    </slot>
    <slot />
    <slot name="footer">
      <SiteFooter
        displayName={site.displayName}
        siteName={site.name}
        line={site.footer.line}
        status={site.footer.status}
      />
    </slot>
  </body>
</html>
