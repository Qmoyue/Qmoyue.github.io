---
import NavigationMenu from "../../islands/NavigationMenu.vue";
import Icon from "../shared/Icon.astro";
import type { NavigationItem } from "../../framework/contracts/navigation";
import { isActivePath } from "../../lib/navigation";

interface Props {
  items: readonly NavigationItem[];
}
const { items } = Astro.props;
---

<div class="nav-island">
  <NavigationMenu items={items} currentPath={Astro.url.pathname} client:load />
</div>
<noscript>
  <style>
    .nav-island {
      display: none;
    }
  </style>
  <nav class="top-nav" aria-label="主导航">
    <details class="nav-fallback">
      <summary class="nav-trigger" aria-label="打开导航"></summary>
      <div class="nav-panel">
        {
          items.map((item) => (
            <a
              class:list={[
                "nav-item",
                { "is-active": isActivePath(Astro.url.pathname, item.href) },
              ]}
              href={item.href}
              aria-current={
                isActivePath(Astro.url.pathname, item.href) ? "page" : undefined
              }
            >
              <span class="nav-icon">
                <Icon name={item.icon} />
              </span>
              <span class="nav-copy">
                <strong>{item.label}</strong>
                <small>{item.subtitle}</small>
              </span>
            </a>
          ))
        }
      </div>
    </details>
  </nav>
</noscript>
