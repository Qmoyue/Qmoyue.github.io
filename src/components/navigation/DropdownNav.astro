---
import NavigationMenu from "../../islands/NavigationMenu.vue";
import Icon from "../shared/Icon.astro";
import { navItems } from "../../site/config";
---

<div class="nav-island">
  <NavigationMenu
    items={navItems}
    currentPath={Astro.url.pathname}
    client:load
  />
</div>
<noscript>
  <style>
    .nav-island {
      display: none;
    }
  </style>
  <nav class="top-nav" aria-label="主导航">
    <details class="nav-fallback">
      <summary class="nav-trigger" aria-label="打开导航"></summary>
      <div class="nav-panel">
        {
          navItems.map((item) => (
            <a class="nav-item" href={item.href}>
              <span class="nav-icon">
                <Icon name={item.icon} />
              </span>
              <span class="nav-copy">
                <strong>{item.label}</strong>
                <small>{item.subtitle}</small>
              </span>
            </a>
          ))
        }
      </div>
    </details>
  </nav>
</noscript>
