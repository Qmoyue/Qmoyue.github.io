---
import { site } from "../../data/site";
---

<div class="scroll-rail" data-scroll-rail>
  <button class="scroll-rail-track" type="button" aria-label="页面滚动进度">
    <span class="scroll-rail-fill"></span>
    <img class="scroll-rail-thumb" src={site.doro} alt="" width="34" height="34" loading="eager" />
  </button>
</div>

<script src="../../scripts/scroll-rail.js"></script>
