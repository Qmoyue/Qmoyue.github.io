---
interface Props {
  label: string;
  columns?: 1 | 2;
}

const { label, columns = 1 } = Astro.props;
---

<section
  class:list={["card-stack", { "card-stack--two": columns === 2 }]}
  aria-label={label}
>
  <slot />
</section>

<style>
  .card-stack {
    display: grid;
    gap: 24px;
    margin-top: 42px;
  }

  @media (min-width: 1100px) {
    .card-stack--two {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
