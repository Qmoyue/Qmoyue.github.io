---
interface Props {
  displayName: string;
  siteName: string;
  line: string;
  status: string;
}

const { displayName, siteName, line, status } = Astro.props;
---

<footer class="site-footer">
  <p>© {new Date().getFullYear()} by {displayName} / {siteName}</p>
  <p class="footer-line">{line}</p>
  <p class="footer-status">{status}</p>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: 2;
    display: grid;
    overflow: hidden;
    width: 100%;
    min-height: clamp(176px, 21vh, 220px);
    margin: auto 0 0;
    padding: 26px 24px 30px;
    place-items: center;
    gap: 3px;
    border: 0;
    border-top: 1px solid rgba(96, 110, 117, 0.26);
    border-radius: 0;
    color: #596b84;
    background: transparent;
    box-shadow: none;
    text-align: center;
    backdrop-filter: none;
    isolation: isolate;
  }

  .site-footer > * {
    position: relative;
    z-index: 1;
  }

  .site-footer p {
    margin: 0;
    font-weight: 900;
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.72);
  }

  .site-footer p:first-child {
    color: #526782;
    font-size: clamp(1rem, 1.35vw, 1.28rem);
  }

  .site-footer .footer-line {
    color: #5e7087;
    font-size: clamp(0.98rem, 1.26vw, 1.18rem);
  }

  .site-footer .footer-status {
    color: #927598;
    font-family: "Courier New", monospace;
    font-size: clamp(0.78rem, 1vw, 0.92rem);
  }
</style>
