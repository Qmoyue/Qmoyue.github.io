---
interface Props {
  count?: number;
}

const { count = 64 } = Astro.props;
if (!Number.isSafeInteger(count) || count < 0) {
  throw new Error("Sakura count must be a non-negative integer");
}

function seededRandom(seed: number): number {
  const value = Math.sin(seed * 9973.17) * 10000;
  return value - Math.floor(value);
}

const petals = Array.from({ length: count }, (_, index) => {
  const seed = index + 1;
  const x = seededRandom(seed) * 100;
  const size = 8 + seededRandom(seed + 11) * 13;
  const drift = (seededRandom(seed + 23) - 0.5) * 28;
  const sway = 4 + seededRandom(seed + 37) * 10;
  const duration = 13 + seededRandom(seed + 41) * 13;
  const delay = -seededRandom(seed + 53) * duration;
  const opacity = 0.22 + seededRandom(seed + 67) * 0.34;
  const spin = 120 + seededRandom(seed + 79) * 380;
  return { x, size, drift, sway, duration, delay, opacity, spin };
});
---

<div class="sakura-field" data-effect="sakura" aria-hidden="true">
  {
    petals.map((petal) => (
      <span
        class="petal"
        style={`--x:${petal.x.toFixed(2)}%; --size:${petal.size.toFixed(2)}px; --drift:${petal.drift.toFixed(2)}vw; --sway:${petal.sway.toFixed(2)}vw; --duration:${petal.duration.toFixed(2)}s; --delay:${petal.delay.toFixed(2)}s; --opacity:${petal.opacity.toFixed(2)}; --spin:${petal.spin.toFixed(1)}deg;`}
      />
    ))
  }
</div>

<style>
  .sakura-field {
    position: fixed;
    inset: 0;
    z-index: 32;
    overflow: hidden;
    pointer-events: none;
  }

  .petal {
    position: absolute;
    top: -12vh;
    left: var(--x);
    width: calc(var(--size) * 1.38);
    height: calc(var(--size) * 0.52);
    border-radius: 999px 72% 999px 72%;
    background: radial-gradient(
      ellipse at 30% 42%,
      rgba(255, 234, 241, 0.86) 0 24%,
      rgba(236, 165, 193, 0.58) 58%,
      rgba(160, 213, 235, 0.22) 100%
    );
    box-shadow:
      0 0 8px rgba(236, 165, 193, 0.17),
      inset 1px 0 2px rgba(255, 255, 255, 0.38);
    opacity: calc(var(--opacity) * 0.82);
    filter: blur(0.55px);
    transform: translate3d(0, -12vh, 0) rotate(0deg);
    animation: sakura-fall var(--duration) linear infinite;
    animation-delay: var(--delay);
  }

  @keyframes sakura-fall {
    0% {
      transform: translate3d(0, -12vh, 0) rotate(-12deg) scale(0.92);
    }
    32% {
      transform: translate3d(var(--sway), 32vh, 0)
        rotate(calc(var(--spin) * 0.25)) scale(1.02);
    }
    68% {
      transform: translate3d(calc(var(--drift) * 0.62), 72vh, 0)
        rotate(calc(var(--spin) * 0.62)) scale(0.96);
    }
    100% {
      transform: translate3d(var(--drift), 116vh, 0) rotate(var(--spin))
        scale(0.9);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sakura-field {
      display: none;
    }
  }
</style>
