---
import ProfileCardLabel from "./ProfileCardLabel.astro";

interface Props {
  headline: string;
  introduction: string;
}

const { headline, introduction } = Astro.props;
---

<article class="readme-card glass-card">
  <ProfileCardLabel text="README.MD" />
  <h1>{headline}</h1>
  <p>{introduction}</p>
</article>

<style>
  .readme-card {
    min-height: 300px;
    padding: 42px clamp(42px, 5vw, 72px) 42px 42px;
    overflow: hidden;
  }

  h1 {
    margin: 18px 0 20px;
    color: #30415d;
    font-size: clamp(3.6rem, 6.2vw, 6.6rem);
    line-height: 1.02;
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.5);
  }

  .readme-card > p:not(.section-label) {
    max-width: 68em;
    color: #717d91;
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.78;
  }

  @media (max-width: 980px) {
    .readme-card {
      padding: 28px;
      padding-right: clamp(42px, 5vw, 72px);
    }
  }
</style>
