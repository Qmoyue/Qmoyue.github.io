---
import ProfileCardLabel from "./ProfileCardLabel.astro";

interface Props {
  items: readonly string[];
}

const { items } = Astro.props;
---

<article class="interests-card glass-card">
  <ProfileCardLabel text="INTEREST TAGS" />
  <h2>兴趣标签</h2>
  <div class="interest-cloud">
    {items.map((item) => <span>{item}</span>)}
  </div>
</article>

<style>
  .interests-card {
    padding: 42px;
    overflow: hidden;
  }

  .interest-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 22px;
  }

  .interest-cloud span {
    padding: 12px 18px;
    border: 1px solid var(--tag-chip-border);
    border-radius: 999px;
    color: var(--tag-chip-ink);
    background: var(--tag-chip-fill);
    font-weight: 900;
  }

  @media (max-width: 980px) {
    .interests-card {
      padding: 28px;
    }
  }
</style>
