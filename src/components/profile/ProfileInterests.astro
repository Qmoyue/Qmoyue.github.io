---
import ProfileCardLabel from "./ProfileCardLabel.astro";

interface Props {
  items: readonly string[];
}

const { items } = Astro.props;
---

<article class="interests-card glass-card">
  <ProfileCardLabel text="INTEREST TAGS" />
  <h2>兴趣标签</h2>
  <div class="interest-cloud">
    {items.map((item) => <span>{item}</span>)}
  </div>
</article>

<style>
  .interests-card {
    padding: 42px;
    overflow: hidden;
  }

  .interest-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 22px;
  }

  .interest-cloud span {
    padding: 12px 18px;
    border-radius: 999px;
    color: #6f6479;
    background: linear-gradient(
      135deg,
      rgba(255, 226, 237, 0.76),
      rgba(236, 249, 253, 0.74)
    );
    box-shadow: inset 0 -1px 0 rgba(255, 255, 255, 0.72);
    font-weight: 900;
  }

  @media (max-width: 980px) {
    .interests-card {
      padding: 28px;
    }
  }
</style>
