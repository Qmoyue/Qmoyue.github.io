---
interface Props {
  src: string;
  alt: string;
}

const { src, alt } = Astro.props;
---

<figure class="profile-avatar">
  <img src={src} alt={alt} width="236" height="236" />
</figure>

<style>
  .profile-avatar {
    position: relative;
    z-index: 3;
    width: 236px;
    height: 236px;
    margin: 0;
  }

  img {
    display: block;
    width: 100%;
    height: 100%;
    border: 8px solid rgba(255, 255, 255, 0.9);
    border-radius: 999px;
    object-fit: cover;
    box-shadow: 0 16px 36px rgba(113, 87, 98, 0.18);
  }
</style>
