---
import type { TechStackItem } from "../../framework/contracts/profile";
import ProfileCardLabel from "./ProfileCardLabel.astro";

interface Props {
  items: readonly TechStackItem[];
  emptyMessage: string;
}

const { items, emptyMessage } = Astro.props;
---

<article class="tech-card glass-card">
  <ProfileCardLabel text="TECH STACK" />
  <h2>技术栈</h2>
  {
    items.length > 0 ? (
      <div class="tech-grid">
        {items.map((tech) => (
          <section class="tech-item" data-tone={tech.tone}>
            <span class="tech-icon">{tech.icon}</span>
            <h3>{tech.name}</h3>
            <p>{tech.description}</p>
          </section>
        ))}
      </div>
    ) : (
      <p class="tech-empty-script">{emptyMessage}</p>
    )
  }
</article>

<style>
  .tech-card {
    padding: 42px;
    overflow: hidden;
  }

  .tech-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 18px;
    margin-top: 26px;
  }

  .tech-item {
    min-height: 150px;
    padding: 24px;
    border: 1px solid rgba(95, 119, 140, 0.13);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.62);
    box-shadow: 0 12px 26px rgba(105, 121, 139, 0.09);
  }

  .tech-icon {
    display: grid;
    width: 52px;
    height: 52px;
    place-items: center;
    margin-bottom: 24px;
    border-radius: 12px;
    color: var(--blue-deep);
    background: var(--blue-soft);
    font-weight: 950;
  }

  .tech-item[data-tone="pink"] .tech-icon {
    background: var(--pink-soft);
  }
  .tech-item[data-tone="mint"] .tech-icon {
    background: var(--mint);
  }
  .tech-item[data-tone="yellow"] .tech-icon {
    background: var(--yellow);
  }
  .tech-item[data-tone="peach"] .tech-icon {
    background: var(--peach);
  }

  .tech-item h3 {
    margin: 0 0 8px;
    font-size: 1.35rem;
  }

  .tech-item p {
    margin: 0;
    font-size: 0.96rem;
  }

  .tech-card .tech-empty-script {
    margin: 34px 0 0;
    color: transparent;
    background:
      radial-gradient(
        circle at 16% 18%,
        rgba(255, 255, 255, 0.88),
        transparent 0.48em
      ),
      linear-gradient(
        105deg,
        #df6f9f 0%,
        #e99ab8 30%,
        #88cbe7 66%,
        #e6b960 100%
      );
    -webkit-background-clip: text;
    background-clip: text;
    filter: drop-shadow(0 2px 0 rgba(255, 255, 255, 0.62))
      drop-shadow(0 14px 22px rgba(102, 118, 142, 0.14));
    font-family:
      "Segoe Script", "STXingkai", "华文行楷", "KaiTi", "Microsoft YaHei",
      cursive;
    font-size: clamp(2rem, 3.8vw, 3.9rem);
    font-weight: 800;
    line-height: 1.25;
  }

  @media (max-width: 980px) {
    .tech-card {
      padding: 28px;
    }
  }

  @media (max-width: 760px) {
    .tech-card .tech-empty-script {
      font-size: clamp(1.8rem, 10vw, 3rem);
    }
  }
</style>
