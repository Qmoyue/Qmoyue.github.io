---
import type { PostSummary } from "../../domain/blog/posts";
import { formatDate } from "../../lib/dates";
interface Props {
  post: PostSummary;
}
const { title, description, pubDate, tags, words } = Astro.props.post;
---

<a class="back-link" href="/blog/">← 回到文章列表</a>
<p class="article-meta">
  <span>{tags[0]}</span>
  <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
  <span>{words.toLocaleString("zh-CN")} 字</span>
</p>
<h1 class="article-title">{title}</h1>
<p class="article-description">{description}</p>
<div class="tag-row">
  {tags.map((tag) => <span class="tag-chip">#{tag}</span>)}
</div>

<style>
  .back-link {
    display: inline-flex;
    margin-bottom: 54px;
    color: #34485e;
    font-weight: 900;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    margin: 0 0 24px;
    color: #3d4856;
    font-weight: 900;
  }

  .article-title {
    margin: 0 0 28px;
    color: #30415d;
    font-size: clamp(3.2rem, 6vw, 6.2rem);
    line-height: 1.04;
    overflow-wrap: anywhere;
    text-shadow: 0 1px 0 rgba(255, 239, 217, 0.24);
  }

  .article-description {
    margin: 0 0 30px;
    color: #4d5864;
    font-size: 1.32rem;
    font-weight: 700;
    line-height: 1.78;
  }
</style>
