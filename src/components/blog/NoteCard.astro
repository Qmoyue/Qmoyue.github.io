---
import { Image } from "astro:assets";
import type { PostSummary } from "../../domain/blog/posts";
import { formatDate } from "../../lib/dates";
import "./note-card.css";

interface Props {
  post: PostSummary;
  index: number;
}

const { post, index } = Astro.props;
const date = post.updatedDate ?? post.pubDate;
---

<article
  class="timeline-entry blog-note"
  data-note-card
  data-search={post.searchText}
>
  <div class="timeline-date">
    <time datetime={date.toISOString()}>{formatDate(date)}</time>
    <span>updated</span>
    <i aria-hidden="true"></i>
  </div>
  <a class="note-card soft-card" href={post.href} style={`--stagger:${index}`}>
    <div class="photo-frame">
      <span class="photo-tape" aria-hidden="true"></span>
      {
        (
          <Image
            src={post.cover.src}
            alt={post.coverAlt}
            width={320}
            height={390}
            loading={index === 0 ? "eager" : "lazy"}
            decoding="async"
          />
        )
      }
      <span class="photo-notch" aria-hidden="true"></span>
    </div>
    <div class="note-copy">
      <p class="note-meta">
        <span>{post.tags[0]}</span>
        <span>发布 {formatDate(post.pubDate)}</span>
        {post.updatedDate && <span>更新 {formatDate(post.updatedDate)}</span>}
      </p>
      <h2>{post.title}</h2>
      <p>{post.description}</p>
      <div class="tag-row">
        {post.tags.map((tag) => <span class="tag-chip">#{tag}</span>)}
      </div>
      <span class="word-count">{post.words.toLocaleString("zh-CN")} 字</span>
    </div>
  </a>
</article>
