---
import "../../styles/prose/article.css";
---

<article class="article-card">
  <slot name="header" />
  <div class="article-prose"><slot /></div>
</article>

<style>
  .article-card {
    position: relative;
    overflow: visible;
    padding: 64px clamp(34px, 5vw, 74px);
    border: 1px solid #c6b49e;
    border-radius: var(--radius);
    background:
      repeating-linear-gradient(
        2deg,
        transparent 0 47px,
        rgba(112, 89, 67, 0.02) 48px 49px,
        transparent 50px 127px
      ),
      linear-gradient(95deg, #f5eadb, #eadfce 54%, #f2e7d8);
    box-shadow:
      0 16px 34px rgba(89, 73, 57, 0.12),
      inset 0 1px 0 rgba(255, 253, 245, 0.8);
  }

  @media (max-width: 980px) {
    .article-card {
      padding-block: 28px;
    }
  }

  @media (max-width: 760px) {
    .article-card {
      padding-inline: 22px;
    }
  }
</style>
