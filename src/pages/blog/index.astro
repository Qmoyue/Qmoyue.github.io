---
import BaseLayout from "../../layouts/BaseLayout.astro";
import NoteCard from "../../components/blog/NoteCard.astro";
import ArchiveSearch from "../../islands/ArchiveSearch.vue";
import PageIntro from "../../components/shared/PageIntro.astro";
import { blogRepository } from "../../site/blog";

const posts = await blogRepository.listSummaries();
---

<BaseLayout
  metadata={{
    kind: "website",
    title: "Blog",
    description: "开发经验、站点折腾和兴趣记录。",
  }}
>
  <main class="page-shell">
    <PageIntro eyebrow="ARCHIVE" title="Blog" scriptLead="my-blog" />

    <ArchiveSearch total={posts.length} client:idle>
      <section class="timeline" aria-label="博客时间轴">
        {posts.map((post, index) => <NoteCard post={post} index={index} />)}
      </section>
    </ArchiveSearch>
  </main>
</BaseLayout>
