---
import { render } from "astro:content";
import { getImage } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleToc from "../../islands/ArticleToc.vue";
import ArticleCard from "../../components/blog/ArticleCard.astro";
import ArticleHeader from "../../components/blog/ArticleHeader.astro";
import { blogRepository } from "../../site/blog";
import "./article.css";

export async function getStaticPaths() {
  const posts = await blogRepository.listDetails();
  return posts.map((post) => ({
    params: { id: post.summary.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post.entry);
const { title, description, pubDate } = post.summary;
const socialCover = await getImage({
  src: post.summary.cover.src,
  width: 1200,
  height: 630,
  fit: "cover",
});
---

<BaseLayout
  metadata={{
    kind: "article",
    title,
    description,
    image: socialCover.src,
    publishedAt: pubDate,
    updatedAt: post.summary.updatedDate,
  }}
>
  <main class="page-shell article-shell">
    <ArticleCard>
      <ArticleHeader slot="header" post={post.summary} />
      <Content />
    </ArticleCard>

    <ArticleToc headings={headings} client:idle />
  </main>
</BaseLayout>
