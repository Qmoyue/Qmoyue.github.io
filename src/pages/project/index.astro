---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/project/ProjectCard.astro";
import CardStack from "../../components/shared/CardStack.astro";
import PageIntro from "../../components/shared/PageIntro.astro";
import { projects } from "../../site/projects";
---

<BaseLayout
  metadata={{
    kind: "website",
    title: "Project",
    description: "项目、实验和 GitHub 仓库记录。",
  }}
>
  <main class="page-shell">
    <PageIntro eyebrow="PROJECTS" title="Project" scriptLead="my-projects" />

    <CardStack label="项目列表">
      {
        projects.length > 0 ? (
          projects.map((project) => <ProjectCard project={project} />)
        ) : (
          <p class="sr-only">当前没有公开项目</p>
        )
      }
    </CardStack>
  </main>
</BaseLayout>
