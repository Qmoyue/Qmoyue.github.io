---
import BaseLayout from "../layouts/BaseLayout.astro";
import { createHomePageModel } from "../domain/home/model";
import HomeExperience from "../presets/moyue/HomeExperience.vue";
import { site, navItems } from "../site/config";
import { homeContent } from "../site/home";
import "../presets/moyue/home.css";
import "../presets/moyue/home-second.css";

const model = createHomePageModel(
  site,
  homeContent,
  new Date(),
  navItems.filter((item) => item.href !== "/"),
);
---

<BaseLayout
  metadata={{
    kind: "website",
    title: site.name,
    description: site.description,
    image: site.socialImage,
  }}
  bodyClass="home-page"
  showReadingProgress={false}
>
  <HomeExperience model={model} thumbSrc={site.doro} client:load />
</BaseLayout>
