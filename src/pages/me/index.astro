---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProfileAvatar from "../../components/profile/ProfileAvatar.astro";
import ProfileBoard from "../../components/profile/ProfileBoard.astro";
import ProfileInterests from "../../components/profile/ProfileInterests.astro";
import ProfileIntro from "../../components/profile/ProfileIntro.astro";
import ProfileReadme from "../../components/profile/ProfileReadme.astro";
import ProfileTechStack from "../../components/profile/ProfileTechStack.astro";
import { site } from "../../site/config";
import { profile } from "../../site/profile";
---

<BaseLayout
  metadata={{
    kind: "website",
    title: "Me",
    description: "关于 Moyue 的个人介绍、兴趣和技术栈。",
  }}
>
  <ProfileBoard>
    <ProfileAvatar
      slot="sidebar"
      src={site.avatar}
      alt={`${site.displayName} avatar`}
    />
    <ProfileIntro
      slot="sidebar"
      scriptName={profile.scriptName}
      displayName={site.displayName}
      siteName={site.name}
      bio={profile.bio}
    />
    <ProfileReadme
      headline={profile.headline}
      introduction={profile.introduction}
    />
    <ProfileInterests items={profile.interests} />
    <ProfileTechStack
      items={profile.techStack}
      emptyMessage={profile.emptyTechMessage}
    />
  </ProfileBoard>
</BaseLayout>
